{
  "name": "deepchat",
  "private": true,
  "version": "1.5.0",
  "description": "Local-first desktop AI Agent client with auditable tools and DeepSeek cache telemetry",
  "author": "DeepChat",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:agent-eval": "vitest run tests/agent-eval.test.ts",
    "lint": "node scripts/check-source.mjs",
    "lint:biome": "biome check --formatter-enabled=false .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "syntax": "node --check electron.js && node --check preload.js",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "test:coverage": "vitest run --coverage",
    "quality:budget": "node scripts/check-quality-budget.mjs",
    "verify:agent": "npm run test:agent-eval && npm run quality:budget",
    "verify:quality": "npm run lint && npm run lint:biome && npm run typecheck && npm run typecheck:strict && npm run test:coverage",
    "verify": "npm run format:check && npm run lint && npm run lint:biome && npm run typecheck && npm run typecheck:strict && npm run verify:agent && npm test && npm run build",
    "verify:prod": "npm run verify && npm run build:electron && npm run test:e2e:built",
    "verify:release": "npm run release:sbom && npm run release:checksums && node scripts/verify-release.mjs && npm run release:smoke",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "release:checksums": "node scripts/generate-checksums.mjs",
    "release:smoke": "node scripts/smoke-release-artifact.mjs",
    "preview": "vite preview",
    "build:web": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "electron:dev": "npm run build:web && npm run build:electron && electron .",
    "package:setup:built": "electron-builder --win --x64",
    "package:portable:built": "electron-builder --win portable",
    "electron:build": "npm run build:web && npm run build:electron && npm run package:setup:built",
    "electron:build:portable": "npm run build:web && npm run build:electron && npm run package:portable:built",
    "test:e2e:built": "npx playwright test",
    "test:e2e": "npm run build:web && npm run build:electron && npm run test:e2e:built",
    "prepare": "simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run format:check && npm run lint",
    "pre-push": "npm run verify"
  },
  "build": {
    "appId": "com.deepchat.app",
    "productName": "DeepChat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.js",
      "dist-electron/**/*",
      "build/**/*",
      "skills/**/*"
    ],
    "win": {
      "artifactName": "DeepChat-Setup-v${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepChat"
    },
    "portable": {
      "artifactName": "DeepChat-Portable-v${version}-${env.BUILD_TIMESTAMP}.exe"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@playwright/test": "^1.60.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "dompurify": "^3.4.7",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "marked": "^18.0.4",
    "mermaid": "^11.15.0",
    "zod": "^4.4.3"
  }
}
